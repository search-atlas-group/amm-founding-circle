<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.searchatlas.shep-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@SHEP_ROOT@/scripts/shep_control_loop.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SHEP_ROOT</key>
    <string>@SHEP_ROOT@</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
